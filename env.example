# Copy to .env.local (gitignored). Names only — never commit real secrets.

# Public (safe for browser bundle)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Public site origin. Optional in local development; REQUIRED and HTTPS on
# hosted Production (for example https://immigratiimprenditori.it).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional first-party aggregate analytics. Keep both false for the first
# Production release; enable together only after privacy/runtime verification.
NEXT_PUBLIC_PRIVACY_ANALYTICS_ENABLED=false
PRIVACY_ANALYTICS_WRITE_ENABLED=false

# Server-only — NEVER prefix with NEXT_PUBLIC_
# Required only on hosted Production. Used by observatory/contents ingest apply
# helpers and persistent pre-authentication login rate limiting. Keep it out of
# previews and never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional explicit override. Hosted Netlify/Vercel previews are detected
# automatically and forced read-only even when this variable is absent.
NEXT_PUBLIC_PREVIEW_READ_ONLY=false
