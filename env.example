# Copy to .env.local (gitignored). Names only — never commit real secrets.

# Public (safe for browser bundle)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Public site origin used for redirects/metadata.
# Production canonical: https://immigratiimprenditori.it
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — NEVER prefix with NEXT_PUBLIC_
# Required in production for privileged server operations, including the
# persistent pre-authentication login rate-limit gate. Keep it out of previews.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional explicit override. Hosted Netlify/Vercel previews are detected
# automatically and forced read-only even when this variable is absent.
NEXT_PUBLIC_PREVIEW_READ_ONLY=false

# First-party no-cookie analytics. Both switches must be true to collect.
# Keep false until production collection is intentionally enabled.
NEXT_PUBLIC_PRIVACY_ANALYTICS_ENABLED=false
PRIVACY_ANALYTICS_WRITE_ENABLED=false
