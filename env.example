# Copy to .env.local (gitignored). Names only — never commit real secrets.

# Public (safe for browser bundle)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Optional public site origin (metadata). Domain cut-over is not decided here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — NEVER prefix with NEXT_PUBLIC_
# Used by observatory/contents ingest and the editorial radar. Never expose in UI.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Random secret (at least 16 characters) used to authenticate the Vercel Cron request.
CRON_SECRET=replace-with-a-random-secret
