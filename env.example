# Copy to .env.local (gitignored). Names only — never commit real secrets.
# `.env*` is gitignored; only this example file documents required names.

# ---------------------------------------------------------------------------
# Development (local Supabase via `npx supabase start`)
# ---------------------------------------------------------------------------
# Public (safe for browser bundle)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Optional public site origin (auth email redirects, metadataBase, robots/sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — NEVER prefix with NEXT_PUBLIC_
# Required for access_provision_account (service_role RPC) on signup path
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Hosted Supabase / production Next.js
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# Deploy checklist:
# - SUPABASE_SERVICE_ROLE_KEY must be server-only (never NEXT_PUBLIC_)
# - App fails at runtime with clear "Missing environment variable: …" if required vars absent
# - Local smoke/E2E refuse non-local API_URL
