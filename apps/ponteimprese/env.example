# Copy to .env.local (gitignored). Names only — never commit real secrets.

# Public (safe for browser bundle)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Optional public site origin (auth email redirects, metadataBase, robots/sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — NEVER prefix with NEXT_PUBLIC_
# Required for access_provision_account (service_role RPC) on signup path
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only HMAC for M2 subject_ref (min 32 chars). Required only when inserting
# legal_retention_records. Never commit real values.
LEGAL_SUBJECT_HMAC_SECRET=local-dev-only-replace-with-32plus-chars
